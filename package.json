{
  "name": "tattoo-tips",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:images": "node scripts/build-images.mjs",
    "prebuild": "npm run validate:content && npm run generate:sitemap",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "check:links": "tsx scripts/check-links.ts",
    "audit:viewport": "node scripts/audit-viewport.mjs",
    "audit:states": "node scripts/audit-states.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "audit": "npm run audit:viewport && npm run audit:contrast && npm run audit:states && npm run audit:perf",
    "audit:contrast": "node scripts/audit-contrast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/sora": "^5.1.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
